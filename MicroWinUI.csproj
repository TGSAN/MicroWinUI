<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net48</TargetFramework>
		<TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
		<TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
		<LangVersion>latest</LangVersion>
		<ApplicationManifest>App.manifest</ApplicationManifest>
		<UseWindowsForms>true</UseWindowsForms>
		<!-- 排除目录内用于参考的第三方源码树，避免被默认通配符（*.cs / *.xaml）编入项目 -->
		<DefaultItemExcludes>$(DefaultItemExcludes);microsoft-ui-xaml\**;WindowsAppSDK\**</DefaultItemExcludes>
		<DefaultExcludesInProjectFolder>$(DefaultExcludesInProjectFolder);microsoft-ui-xaml\**;WindowsAppSDK\**</DefaultExcludesInProjectFolder>
		<!-- Add workaround for WinRT support in the old .NET SDK -->
		<SupportedOSPlatformVersion>$(TargetPlatformMinVersion)</SupportedOSPlatformVersion>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<!-- 不再使用 XAML 编译器 / XBF / PRI：界面与样式改为运行时从嵌入资源解析 -->
		<MileXamlNoSunValleyXamlStyle>true</MileXamlNoSunValleyXamlStyle>
		<MileXamlManagedNoNativeBackend>true</MileXamlManagedNoNativeBackend>
		<DisableEmbeddedXbf>true</DisableEmbeddedXbf>
		<GenerateLibraryLayout>false</GenerateLibraryLayout>
		<AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
		<EnableDefaultPageItems>false</EnableDefaultPageItems>
		<EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Costura.Fody" Version="4.1.0" />
		<PackageReference Include="Mile.Xaml" Version="2.5.1616" />
	</ItemGroup>

	<ItemGroup>
		<!-- XAML 源文件不直接参与编译，由下方 CompressXamlResources 压缩后再嵌入 -->
		<None Remove="*.xaml" />
		<None Include="App.xaml" />
		<None Include="MainPage.xaml" />
		<None Include="Assets\Styles\SunValley.xaml" />
	</ItemGroup>

	<ItemGroup>
		<!-- 仅带 x:Class 的页面参与代码生成，Assets 下资源字典只作为嵌入资源处理。 -->
		<XamlCodeBehindPage Include="**\*.xaml" Exclude="App.xaml;Assets\**\*.xaml;microsoft-ui-xaml\**;WindowsAppSDK\**" />
	</ItemGroup>

	<!--
	  把 XAML 压缩成 gzip 后作为嵌入资源编入 exe。
	  XAML 文本压缩率很高（样式字典约 6%），可显著减小产物体积。
	  运行时由 XamlPageLoader 识别 gzip 头自动解压，调用方无感知。
	-->
	<PropertyGroup>
		<!-- IntermediateOutputPath 在部分旧版 MSBuild 的 PrepareForBuild 阶段可能尚未初始化，
		     这里显式使用 obj\配置\目标框架，避免临时文件回落到项目根目录。 -->
		<_CompressedXamlDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\CompressedXaml\</_CompressedXamlDir>
		<_CompressXamlScript>$(MSBuildThisFileDirectory)build\Compress-Xaml.ps1</_CompressXamlScript>
		<_GeneratedXamlDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\GeneratedXaml\</_GeneratedXamlDir>
		<_GenerateXamlScript>$(MSBuildThisFileDirectory)build\Generate-XamlCodeBehind.ps1</_GenerateXamlScript>
	</PropertyGroup>

	<Target Name="GenerateXamlCodeBehind" BeforeTargets="CoreCompile">
		<RemoveDir Directories="$(_GeneratedXamlDir)" />
		<Exec
			Command="powershell -NoProfile -File &quot;$(_GenerateXamlScript)&quot; -Source &quot;%(XamlCodeBehindPage.FullPath)&quot; -Output &quot;$(_GeneratedXamlDir)%(XamlCodeBehindPage.RecursiveDir)%(XamlCodeBehindPage.Filename).g.cs&quot; -RelativePath &quot;%(XamlCodeBehindPage.Identity)&quot;"
			ContinueOnError="false" />
		<ItemGroup>
			<Compile Include="$(_GeneratedXamlDir)**\*.g.cs" AutoGen="true" DesignTime="true" />
			<FileWrites Include="$(_GeneratedXamlDir)**\*.g.cs" />
		</ItemGroup>
	</Target>

	<Target Name="CompressXamlResources" BeforeTargets="PrepareForBuild">
		<ItemGroup>
			<!-- 页面与 Assets 下资源字典统一压缩，保留相对目录避免同名文件冲突。 -->
			<_XamlCodeBehindPageSource Include="@(XamlCodeBehindPage)" />
			<_XamlStyleSource Include="Assets\**\*.xaml" Exclude="microsoft-ui-xaml\**;WindowsAppSDK\**" />
			<_XamlSource Include="@(_XamlCodeBehindPageSource);@(_XamlStyleSource)" />
		</ItemGroup>

		<Exec
			Command="powershell -NoProfile -File &quot;$(_CompressXamlScript)&quot; -Source &quot;%(_XamlSource.FullPath)&quot; -Destination &quot;$(_CompressedXamlDir)%(_XamlSource.RelativeDir)%(_XamlSource.Filename)%(_XamlSource.Extension).gz&quot;"
			ContinueOnError="false" />

		<ItemGroup>
			<EmbeddedResource Include="$(_CompressedXamlDir)%(_XamlSource.RelativeDir)%(_XamlSource.Filename)%(_XamlSource.Extension).gz">
				<LogicalName>MicroWinUI.Assets.%(_XamlSource.RelativeDir)%(_XamlSource.Filename)%(_XamlSource.Extension)</LogicalName>
			</EmbeddedResource>
		</ItemGroup>
	</Target>

	<Target Name="CleanGeneratedXaml" AfterTargets="Clean">
		<RemoveDir Directories="$(_GeneratedXamlDir)" />
	</Target>

</Project>
